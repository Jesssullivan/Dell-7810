export DELL_7810_CHAPEL_ANALYSIS_FLAKE="path:.#chapel"

if command -v git >/dev/null 2>&1 &&
   [[ -e ../chapel ]] &&
   git -C ../chapel show-ref --verify --quiet refs/heads/chapel-dell-7810-packaging; then
  export DELL_7810_CHAPEL_COMPILER_FLAKE="git+file://$(cd ../chapel && pwd)?ref=chapel-dell-7810-packaging&shallow=1#chapel-llvm19"
  export DELL_7810_CHAPEL_SOURCE_POLICY="sibling-branch-local-analysis"
elif [[ -f /tmp/chapel-dell-7810-packaging/flake.nix ]]; then
  export DELL_7810_CHAPEL_COMPILER_FLAKE="path:/tmp/chapel-dell-7810-packaging#chapel-llvm19"
  export DELL_7810_CHAPEL_SOURCE_POLICY="preview-worktree-local-analysis"
elif [[ -f ../chapel/flake.nix ]]; then
  export DELL_7810_CHAPEL_COMPILER_FLAKE="path:../chapel#chapel-llvm19"
  export DELL_7810_CHAPEL_SOURCE_POLICY="external-compiler-local-analysis"
else
  export DELL_7810_CHAPEL_COMPILER_FLAKE="$DELL_7810_CHAPEL_ANALYSIS_FLAKE"
  export DELL_7810_CHAPEL_SOURCE_POLICY="local-only"
fi

use flake path:.#chapel
