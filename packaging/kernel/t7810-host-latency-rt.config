# Dell Precision 7810 host-latency RT overlay
#
# Apply this only after the non-RT host baseline is booting cleanly and the
# workstation is stable under the generic host-latency posture.

CONFIG_PREEMPT_RT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_NONE is not set

# The current shipped linux-xr RT lane on honey still reports
# CONFIG_PREEMPT_DYNAMIC=y. Keep the Dell RT overlay aligned to the live
# supplier surface by requiring PREEMPT_RT itself and the disabled fallback
# modes, but do not assert PREEMPT_DYNAMIC=n here.
