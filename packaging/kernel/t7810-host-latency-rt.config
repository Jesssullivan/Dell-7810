# Dell Precision 7810 host-latency RT overlay
#
# Apply this only after the non-RT host baseline is booting cleanly and the
# workstation is stable under the generic host-latency posture.

CONFIG_PREEMPT_RT=y
# CONFIG_PREEMPT_VOLUNTARY is not set
# CONFIG_PREEMPT_NONE is not set
# CONFIG_PREEMPT_DYNAMIC is not set
