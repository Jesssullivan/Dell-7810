# Dell Precision 7810 host-latency base fragment
#
# This is the generic host baseline for workstation timing and recovery work.
# It intentionally excludes Bigscreen Beyond and AMD DSC patch carrying.

CONFIG_HZ=1000
CONFIG_HZ_1000=y
# CONFIG_HZ_250 is not set

CONFIG_HWLAT_TRACER=y
CONFIG_OSNOISE_TRACER=y
CONFIG_TIMERLAT_TRACER=y
CONFIG_TRACER_SNAPSHOT=y
CONFIG_X86_MSR=y

CONFIG_HIGH_RES_TIMERS=y
CONFIG_CPU_ISOLATION=y
CONFIG_NO_HZ_FULL=y
CONFIG_RCU_NOCB_CPU=y
CONFIG_IRQ_FORCED_THREADING=y

CONFIG_UIO=y
CONFIG_UIO_PCI_GENERIC=y

# Disable firmware and watchdog surfaces known to be hostile to the
# T7810 host timing contract or systemd 257 expectations.
# CONFIG_DELL_RBU is not set
# CONFIG_ITCO_WDT is not set
# CONFIG_FW_LOADER_USER_HELPER is not set

# Preserve BTF for systemd/cgroup BPF expectations.
CONFIG_DEBUG_INFO=y
# CONFIG_DEBUG_INFO_REDUCED is not set
# CONFIG_DEBUG_INFO_SPLIT is not set
# CONFIG_DEBUG_INFO_NONE is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y

CONFIG_BPF_SYSCALL=y
CONFIG_CGROUP_BPF=y
CONFIG_AUTOFS_FS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y
