[cctk]
sysname=Precision Tower 7810
sysid=0618
biosver=A34
;do not edit information above this line
acpower=off
adjcacheprefetch=enable
admsetuplockout=disable
advsm=TEMPERATURE_1:92
advsm=TEMPERATURE_2:92
advsm=TEMPERATURE_3:40
advsm=TEMPERATURE_4:75
advsm=TEMPERATURE_5:75
advsm=CD_1:96
advsm=CD_2:96
advsm=CD_3:96
advsm=CD_4:96
advsm=CD_5:96
asset=<redacted>
autoon=disable
autoonhr=0
autoonmn=0
blocks3=enable
bootorder=uefitype,+hdd.1,+hdd.2
;Here '+' indicates Enabled device, '-' indicates Disabled device.You can use DeviceNumber also to set the boot order. Example: bootorder=+2,-1,+3
boottimevideo=onboard
chasintrusion=disable
;chassisintrustatus=doorclosed
cpuxdsupport=enable
cstatesctrl=disable
deepsleepctrl=disable
drmt=enable
embnic1=onnopxe
embsataraid=ahci
energystarlogo=disable
fanctrlovrd=disable
fanspeed=auto
fastboot=thorough
;firstpowerondate=20141217
forcepxeonnextboot=disable
hdd1fanenable=disable
hwprefetcher=enable
integratedaudio=enable
legacyorom=disable
limitcpuidvalue=off
logicproc=enable
memintleave=enable
;mfgdate=20141119
mmioabove4gb=enable
numlock=on
oromkeyboardaccess=enable
passwordbypass=off
pcimmiospacesize=large
pcislots=enable
postf12key=disable
postmebxkey=on
propowntag=
pwdlock=unlock
rearusb=enable
rptkeyerr=disable
sata0=auto
sata1=auto
sata2=auto
sata3=auto
sata4=auto
sata5=auto
serial1=com1
serrdmimsg=off
smarterrors=enable
speedstep=disable
strongpwd=disable
svctag=<redacted>
tpm=off
tpmactivation=deactivated
trustexecution=off
turbomode=disable
uefinwstack=disable
usb30=enable
usbemu=disable
usbportsfront=enable
usbwake=enable
;uuid=<redacted>
virtualization=enable
vtfordirectio=on
wakeonlan=enable
wysep25access=enable
