#!/usr/bin/env python3
"""Project a saved NUMA capture JSON file into a Dhall host-inventory record."""

from __future__ import annotations

import argparse
import json
from pathlib import Path


def dhall_text(value: str) -> str:
    escaped = (
        value.replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\t", "\\t")
    )
    return f'"{escaped}"'


def dhall_optional_text(value: str | None) -> str:
    if value is None or value == "":
        return "None Text"
    return f"Some {dhall_text(value)}"


def dhall_optional_natural(value: int | None) -> str:
    if value is None:
        return "None Natural"
    return f"Some {value}"


def dhall_optional_bool(value: bool | None) -> str:
    if value is None:
        return "None Bool"
    return f"Some {'True' if value else 'False'}"


def dhall_list_text(values: list[str]) -> str:
    if not values:
        return "[] : List Text"
    inner = "\n      , ".join(dhall_text(v) for v in values)
    return f"[ {inner} ]"


def load_capture(path: Path) -> dict:
    with path.open() as fh:
        return json.load(fh)


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("capture_json", type=Path)
    parser.add_argument("--owner-issue", default=None)
    parser.add_argument("--operator", default=None)
    parser.add_argument("--purpose", default="Clean workstation baseline")
    args = parser.parse_args()

    capture = load_capture(args.capture_json)
    meta = capture.get("capture", {})
    firmware = capture.get("firmware", {})
    summary = capture.get("summary", {})
    notes = []
    linux_note = capture.get("linux_specific_note")
    if linux_note:
        notes.append(linux_note)

    output = f"""let HostInventory = ../types/HostInventoryRecord.dhall

let record
    : HostInventory.HostInventoryRecord
    = {{ date = {dhall_text(str(meta.get("timestamp", ""))[:10])}
      , ownerIssue = {dhall_optional_text(args.owner_issue)}
      , host = {dhall_text(meta.get("hostname", "unknown"))}
      , operator = {dhall_optional_text(args.operator)}
      , intendedPurpose = {dhall_optional_text(args.purpose)}
      , captureRef = Some {dhall_text(str(args.capture_json))}
      , biosVersion = {dhall_optional_text(firmware.get("bios_version"))}
      , boardName = {dhall_optional_text(firmware.get("board_name"))}
      , cpuModel = {dhall_optional_text(summary.get("cpu_model"))}
      , totalRamGiB = {dhall_optional_natural(summary.get("total_ram_gib_floor"))}
      , numaNodesObserved = {dhall_optional_natural(summary.get("numa_nodes_observed"))}
      , cpusPerNode = {dhall_list_text(summary.get("cpus_per_node", []))}
      , asymmetryNotes = [] : List Text
      , kernelVersion = {dhall_optional_text(meta.get("kernel"))}
      , genericHostLatencyBaseline = None Bool
      , rtOverlayInUse = None Bool
      , bootCmdlineSource = None Text
      , tunedProfile = None Text
      , notes = {dhall_list_text(notes)}
      , followUp =
          [ "Review cpusPerNode and asymmetry notes against the live host."
          , "Fill genericHostLatencyBaseline, rtOverlayInUse, bootCmdlineSource, and tunedProfile from the real host posture."
          ]
      }}

in  record
"""
    print(output, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
