#!/usr/bin/env python3
"""Project a saved reset capture JSON file into a Dhall reset-run record."""

from __future__ import annotations

import argparse
import json
from pathlib import Path


RESET_TRIGGERS = {
    "warm-reboot": "Reset.ResetTrigger.warm-reboot",
    "shutdown-power-on": "Reset.ResetTrigger.shutdown-power-on",
    "hard-reset": "Reset.ResetTrigger.hard-reset",
    "ac-break": "Reset.ResetTrigger.ac-break",
}

RUN_OUTCOMES = {
    "pass": "Reset.RunOutcome.pass",
    "fail": "Reset.RunOutcome.fail",
    "partial": "Reset.RunOutcome.partial",
    "historical": "Reset.RunOutcome.historical",
}


def dhall_text(value: str) -> str:
    escaped = (
        value.replace("\\", "\\\\")
        .replace('"', '\\"')
        .replace("\n", "\\n")
        .replace("\r", "\\r")
        .replace("\t", "\\t")
    )
    return f'"{escaped}"'


def dhall_optional_text(value: str | None) -> str:
    if value is None or value == "":
        return "None Text"
    return f"Some {dhall_text(value)}"


def dhall_list_text(values: list[str]) -> str:
    if not values:
        return "[] : List Text"
    inner = "\n          , ".join(dhall_text(v) for v in values)
    return f"[ {inner} ]"


def load_capture(path: Path) -> dict:
    with path.open() as fh:
        return json.load(fh)


def summarize_connector(connectors: list[dict], connector_name: str) -> str:
    for connector in connectors:
        if connector.get("name") == connector_name:
            modes = connector.get("modes") or []
            mode_text = ", ".join(modes) if modes else "no modes"
            return (
                f"{connector_name} status={connector.get('status', 'unknown')} "
                f"enabled={connector.get('enabled', 'unknown')} modes={mode_text}"
            )
    return f"{connector_name} not present in capture"


def summarize_remote_state(network_surface: dict, linux_note: str | None) -> str:
    if linux_note:
        return linux_note
    sshd = network_surface.get("sshd")
    tailscaled = network_surface.get("tailscaled")
    if sshd is None and tailscaled is None:
        return "network state unavailable"
    return f"sshd={sshd or 'unknown'}, tailscaled={tailscaled or 'unknown'}"


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("capture_json", type=Path)
    parser.add_argument("--run-id", required=True)
    parser.add_argument(
        "--trigger",
        required=True,
        choices=sorted(RESET_TRIGGERS.keys()),
    )
    parser.add_argument(
        "--outcome",
        required=True,
        choices=sorted(RUN_OUTCOMES.keys()),
    )
    parser.add_argument(
        "--ac-power-broken",
        required=True,
        choices=["true", "false"],
    )
    parser.add_argument("--note", default=None)
    args = parser.parse_args()

    capture = load_capture(args.capture_json)
    connectors = capture.get("drm_connectors", [])
    markers = capture.get("kernel_marker_lines", [])
    network_surface = capture.get("network_surface", {})
    linux_note = capture.get("linux_specific_note")

    management_display = summarize_connector(connectors, "card0-HDMI-A-2")
    xr_display = summarize_connector(connectors, "card0-DP-2")
    remote_state = summarize_remote_state(network_surface, linux_note)

    output = f"""let Reset = ../types/ResetRun.dhall

let record
    : Reset.ResetRun
    = {{ runId = {dhall_text(args.run_id)}
      , trigger = {RESET_TRIGGERS[args.trigger]}
      , acPowerBroken = {'True' if args.ac_power_broken == 'true' else 'False'}
      , managementDisplay = {dhall_text(management_display)}
      , xrDisplay = {dhall_text(xr_display)}
      , remoteState = {dhall_text(remote_state)}
      , kernelMarkers = {dhall_list_text(markers)}
      , outcome = {RUN_OUTCOMES[args.outcome]}
      , evidence =
          [ {dhall_text(str(args.capture_json))}
          ]
      , notes = {dhall_optional_text(args.note)}
      }}

in  record
"""
    print(output, end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
