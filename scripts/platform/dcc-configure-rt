#!/usr/bin/env bash
# dcc-configure-rt -- Configure Dell T7810 BIOS for RT-friendly behavior
#
# Uses Dell Command | Configure (cctk) to set BIOS options that reduce
# SMI noise and stabilize timing on the T7810.
#
# Prerequisites:
#   modern DCC path: /opt/dell/dcc/cctk
#   legacy 7810 path: /opt/dell/toolkit/bin/cctk
#
# Usage:
#   sudo ./scripts/platform/dcc-configure-rt [--apply | --check | --export]

set -euo pipefail
export PATH="/usr/sbin:/sbin:/usr/bin:/bin:${PATH:-}"

resolve_cctk() {
    if [ -n "${CCTK:-}" ] && [ -x "${CCTK:-}" ]; then
        printf '%s\n' "$CCTK"
        return 0
    fi

    for candidate in \
        /opt/dell/dcc/cctk \
        /opt/dell/toolkit/bin/cctk
    do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

CCTK_BIN="$(resolve_cctk || true)"
CCTK_MODE="modern"

if [ -n "$CCTK_BIN" ] && [ "$CCTK_BIN" = "/opt/dell/toolkit/bin/cctk" ]; then
    CCTK_MODE="legacy3"
fi

if [ -z "$CCTK_BIN" ]; then
    echo "ERROR: Dell Command | Configure not installed."
    echo "Checked:"
    echo "  /opt/dell/dcc/cctk"
    echo "  /opt/dell/toolkit/bin/cctk"
    echo "Download from Dell Support and install srvadmin-hapi plus command-configure."
    exit 1
fi

declare -A CCTK_EXPORT=()

load_export_settings() {
    local outfile key value
    outfile="$(mktemp /tmp/t7810-bios-settings.XXXXXX.cctk)"
    trap 'rm -f "$outfile"' RETURN

    "$CCTK_BIN" --outfile="$outfile" >/dev/null 2>&1

    while IFS='=' read -r key value; do
        case "$key" in
            ""|\;*|\[*)
                continue
                ;;
        esac
        CCTK_EXPORT["$key"]="$value"
    done < "$outfile"
}

check_export_setting() {
    local label="$1"
    local export_key="$2"
    local expected="$3"
    local note="${4:-}"
    local current="${CCTK_EXPORT[$export_key]-unknown}"
    if [ "$current" = "$expected" ]; then
        echo "  ✓ $label -> $export_key = $current"
    else
        echo "  ✗ $label -> $export_key = $current (expected: $expected)"
    fi
    if [ -n "$note" ]; then
        echo "    note: $note"
    fi
}

case "${1:---check}" in
    --check)
        echo "=== Dell T7810 BIOS settings for low-latency work ==="
        echo "Using cctk: $CCTK_BIN"
        echo "Mode: $CCTK_MODE"
        echo ""
        load_export_settings
        if [ "$CCTK_MODE" = "legacy3" ]; then
            echo "Legacy DCC 3.0 surface detected; using exported legacy field names."
            echo ""
            check_export_setting "usblegacy" "usbemu" "disable"
            check_export_setting "cstates" "cstatesctrl" "disable" \
                "legacy DCC only exposes enable|disable; disable is the closest machine-readable low-latency posture to the newer C1-only target"
            check_export_setting "intelturboboosten" "turbomode" "disable"
            check_export_setting "intelspdstep" "speedstep" "disable"

            if [ -n "${CCTK_EXPORT[hpet]-}" ]; then
                check_export_setting "hpet" "hpet" "enable"
            else
                echo "  ! hpet -> unknown (legacy DCC export does not expose an hpet field on this host)"
            fi

            if [ -n "${CCTK_EXPORT[computrace]-}" ]; then
                check_export_setting "computrace" "computrace" "deactivate"
            else
                echo "  ! computrace -> unknown (legacy DCC export does not expose a computrace field on this host)"
            fi
        else
            check_export_setting "usblegacy" "usblegacy" "disabled"
            check_export_setting "cstates" "cstates" "c1"
            check_export_setting "intelturboboosten" "intelturboboosten" "disabled"
            check_export_setting "intelspdstep" "intelspdstep" "disabled"
            check_export_setting "hpet" "hpet" "enabled"
            check_export_setting "computrace" "computrace" "deactivate"
        fi
        echo ""
        echo "Run with --apply to set these values."
        ;;
    --apply)
        echo "=== Applying low-latency BIOS settings ==="
        echo "Using cctk: $CCTK_BIN"
        echo "Mode: $CCTK_MODE"
        echo ""
        if [ "$CCTK_MODE" = "legacy3" ]; then
            echo "Disabling USB emulation (legacy USB support surface)..."
            "$CCTK_BIN" --usbemu=disable || echo "  (may require reboot)"
            echo "Disabling C-States through the legacy binary toggle..."
            "$CCTK_BIN" --cstatesctrl=disable || echo "  (may require reboot)"
            echo "Disabling Turbo Mode..."
            "$CCTK_BIN" --turbomode=disable || true
            echo "Disabling SpeedStep..."
            "$CCTK_BIN" --speedstep=disable || true
            echo "HPET is not exposed through the legacy DCC export on this host; verify manually in BIOS."
            echo "Computrace is not exposed through the legacy DCC export on this host; verify manually in BIOS."
        else
            echo "Disabling USB Legacy Support..."
            "$CCTK_BIN" --usblegacy=disabled || echo "  (may require reboot)"
            echo "Limiting C-States to C1..."
            "$CCTK_BIN" --cstates=c1 || echo "  (may require reboot)"
            echo "Disabling Intel Turbo Boost..."
            "$CCTK_BIN" --intelturboboosten=disabled || true
            echo "Disabling Intel SpeedStep..."
            "$CCTK_BIN" --intelspdstep=disabled || true
            echo "Enabling HPET fallback clocksource..."
            "$CCTK_BIN" --hpet=enabled || true
            echo "Deactivating Computrace..."
            "$CCTK_BIN" --computrace=deactivate || true
        fi
        echo ""
        echo "Done. Reboot required."
        ;;
    --export)
        echo "=== Exporting current BIOS settings ==="
        echo "Using cctk: $CCTK_BIN"
        echo "Mode: $CCTK_MODE"
        "$CCTK_BIN" --outfile=/tmp/t7810-bios-settings.cctk
        echo "Exported to /tmp/t7810-bios-settings.cctk"
        ;;
    *)
        echo "Usage: $0 [--check | --apply | --export]"
        exit 1
        ;;
esac
