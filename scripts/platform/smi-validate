#!/usr/bin/env bash
# smi-validate -- Characterize SMI latency on Dell T7810 (C610/Wellsburg PCH)
#
# Canonical source of truth for Dell T7810 hardware SMI validation.
# Originally developed in XoxdWM/packaging/scripts/smi-validate, formalized
# here as the Dell-7810-owned host-platform validator.
#
# Based on firmware reverse engineering of T7810A34.exe:
#   - ACPI_BASE = 0x0400
#   - SMI_EN at port 0x0430
#   - SMI_STS at port 0x0434
#
# Usage:
#   sudo ./scripts/platform/smi-validate [--full]
#
# Requires:
#   msr-tools, plus either the hwlatdetect userspace binary or the kernel's
#   built-in tracefs hwlat detector support.

set -euo pipefail
export PATH="/usr/sbin:/sbin:/usr/bin:/bin:${PATH:-}"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    RED='\033[0;31m'
    GRN='\033[0;32m'
    YEL='\033[0;33m'
    NC='\033[0m'
else
    RED=''
    GRN=''
    YEL=''
    NC=''
fi

ok()   { echo -e "  ${GRN}✓${NC} $1"; }
warn() { echo -e "  ${YEL}!${NC} $1"; }
fail() { echo -e "  ${RED}✗${NC} $1"; }

find_bin() {
    local name="$1"
    shift
    if command -v "$name" >/dev/null 2>&1; then
        command -v "$name"
        return 0
    fi

    local candidate
    for candidate in "$@"; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    return 1
}

resolve_trace_root() {
    if [ -d /sys/kernel/tracing ]; then
        printf '%s\n' /sys/kernel/tracing
        return 0
    fi

    if [ -d /sys/kernel/debug/tracing ]; then
        printf '%s\n' /sys/kernel/debug/tracing
        return 0
    fi

    return 1
}

kernel_config_has() {
    local pattern="$1"

    if zcat /proc/config.gz 2>/dev/null | grep -q "$pattern"; then
        return 0
    fi

    if [ -f "/boot/config-$(uname -r)" ] && grep -q "$pattern" "/boot/config-$(uname -r)" 2>/dev/null; then
        return 0
    fi

    return 1
}

run_hwlat_tracefs() {
    local duration="$1"
    local trace_root="$2"
    local hwlat_dir="$trace_root/hwlat_detector"
    local old_tracer old_thresh old_width old_window old_mode old_tracing_on
    local max_latency trace_sample

    if [ ! -d "$hwlat_dir" ]; then
        return 1
    fi

    old_tracer="$(cat "$trace_root/current_tracer" 2>/dev/null || echo nop)"
    old_thresh="$(cat "$trace_root/tracing_thresh" 2>/dev/null || echo 0)"
    old_width="$(cat "$hwlat_dir/width" 2>/dev/null || echo 500000)"
    old_window="$(cat "$hwlat_dir/window" 2>/dev/null || echo 1000000)"
    old_mode="$(cat "$hwlat_dir/mode" 2>/dev/null || echo round-robin)"
    old_tracing_on="$(cat "$trace_root/tracing_on" 2>/dev/null || echo 0)"

    restore_hwlat_tracefs() {
        printf '0\n' > "$trace_root/tracing_on" 2>/dev/null || true
        printf '%s\n' "$old_tracer" > "$trace_root/current_tracer" 2>/dev/null || true
        printf '%s\n' "$old_thresh" > "$trace_root/tracing_thresh" 2>/dev/null || true
        printf '%s\n' "$old_width" > "$hwlat_dir/width" 2>/dev/null || true
        printf '%s\n' "$old_window" > "$hwlat_dir/window" 2>/dev/null || true
        printf '%s\n' "$old_mode" > "$hwlat_dir/mode" 2>/dev/null || true
        printf '%s\n' "$old_tracing_on" > "$trace_root/tracing_on" 2>/dev/null || true
    }

    trap restore_hwlat_tracefs RETURN

    printf '0\n' > "$trace_root/tracing_on"
    : > "$trace_root/trace"
    printf '0\n' > "$trace_root/tracing_max_latency" 2>/dev/null || true
    printf '10\n' > "$trace_root/tracing_thresh"
    printf '500000\n' > "$hwlat_dir/width"
    printf '1000000\n' > "$hwlat_dir/window"
    printf 'round-robin\n' > "$hwlat_dir/mode" 2>/dev/null || true
    printf 'hwlat\n' > "$trace_root/current_tracer"
    printf '1\n' > "$trace_root/tracing_on"
    sleep "$duration"
    printf '0\n' > "$trace_root/tracing_on"

    max_latency="$(cat "$trace_root/tracing_max_latency" 2>/dev/null || echo 0)"
    trace_sample="$(head -n 12 "$trace_root/trace" 2>/dev/null || true)"

    if [ "${max_latency:-0}" = "0" ]; then
        ok "tracefs hwlat max latency: 0 us"
    else
        warn "tracefs hwlat max latency: ${max_latency} us"
    fi

    if [ -n "$trace_sample" ]; then
        echo "  tracefs hwlat trace sample:"
        while IFS= read -r line; do
            echo "    $line"
        done <<EOF
$trace_sample
EOF
    fi

    trap - RETURN
    restore_hwlat_tracefs
    return 0
}

RDMSR_BIN="$(find_bin rdmsr /usr/sbin/rdmsr /sbin/rdmsr || true)"
HWLATDETECT_BIN="$(find_bin hwlatdetect /usr/sbin/hwlatdetect /sbin/hwlatdetect || true)"
TUNED_ADM_BIN="$(find_bin tuned-adm /usr/sbin/tuned-adm /sbin/tuned-adm || true)"
TRACE_ROOT="$(resolve_trace_root || true)"

echo "==============================================================="
echo " Dell T7810 SMI Validation (C610/Wellsburg PCH)"
echo " Based on firmware reverse engineering of BIOS A34"
echo "==============================================================="

echo ""
echo "-- BIOS --"
BIOS_VER=$(cat /sys/class/dmi/id/bios_version 2>/dev/null || echo "unknown")
BIOS_DATE=$(cat /sys/class/dmi/id/bios_date 2>/dev/null || echo "unknown")
if [ "$BIOS_VER" = "A34" ]; then
    ok "BIOS version: $BIOS_VER ($BIOS_DATE)"
elif [ "$BIOS_VER" = "A02" ]; then
    fail "BIOS version: $BIOS_VER ($BIOS_DATE) -- A34 recommended for low-latency work"
else
    warn "BIOS version: $BIOS_VER ($BIOS_DATE) -- A34 recommended"
fi

echo ""
echo "-- Kernel --"
echo "  uname -r: $(uname -r)"
if kernel_config_has "CONFIG_PREEMPT_RT=y"; then
    ok "PREEMPT_RT: enabled"
else
    warn "PREEMPT_RT: not enabled -- using standard preemption"
fi

if kernel_config_has "CONFIG_HZ=1000"; then
    ok "CONFIG_HZ=1000 (1 ms tick)"
else
    warn "CONFIG_HZ != 1000"
fi

echo ""
echo "-- Clocksource --"
CS=$(cat /sys/devices/system/clocksource/clocksource0/current_clocksource)
AVAIL=$(cat /sys/devices/system/clocksource/clocksource0/available_clocksource)
if [ "$CS" = "tsc" ]; then
    ok "Current: $CS"
elif [ "$CS" = "hpet" ]; then
    warn "Current: $CS -- add clocksource=tsc to boot params if stable"
else
    fail "Current: $CS"
fi
echo "  Available: $AVAIL"

echo ""
echo "-- SMI Activity --"
if [ -n "$RDMSR_BIN" ]; then
    SMI_BEFORE=$("$RDMSR_BIN" -p 0 0x34 2>/dev/null || echo "error")
    if [ "$SMI_BEFORE" != "error" ]; then
        echo "  Measuring SMI rate over 10 seconds..."
        sleep 10
        SMI_AFTER=$("$RDMSR_BIN" -p 0 0x34 2>/dev/null || echo "error")
        if [ "$SMI_AFTER" != "error" ]; then
            SMI_DELTA=$((16#$SMI_AFTER - 16#$SMI_BEFORE))
            SMI_RATE=$(awk "BEGIN { printf \"%.1f\", ${SMI_DELTA} / 10 }")
            if [ "$SMI_DELTA" -eq 0 ]; then
                ok "SMI count: 0 in 10s (excellent)"
            elif [ "$SMI_DELTA" -lt 10 ]; then
                warn "SMI count: $SMI_DELTA in 10s (${SMI_RATE}/s) -- acceptable but not clean"
            else
                fail "SMI count: $SMI_DELTA in 10s (${SMI_RATE}/s) -- likely SMI storm"
                fail "  Check USB legacy and other BIOS-managed sources"
            fi
        fi
    else
        warn "Cannot read MSR 0x34 (load msr module and rerun)"
    fi
else
    warn "rdmsr not available -- install msr-tools"
fi

echo ""
echo "-- Hardware Latency --"
if [ -n "$HWLATDETECT_BIN" ]; then
    if [ "${1:-}" = "--full" ]; then
        echo "  Running hwlatdetect for 60s..."
        "$HWLATDETECT_BIN" --duration=60 --threshold=10 2>&1 | while IFS= read -r line; do
            echo "  $line"
        done
    else
        echo "  Running hwlatdetect for 10s (use --full for 60s)..."
        "$HWLATDETECT_BIN" --duration=10 --threshold=10 2>&1 | while IFS= read -r line; do
            echo "  $line"
        done
    fi
elif [ -n "$TRACE_ROOT" ] && [ -d "$TRACE_ROOT/hwlat_detector" ]; then
    warn "hwlatdetect not available -- using tracefs hwlat tracer fallback"
    if [ "${1:-}" = "--full" ]; then
        echo "  Running tracefs hwlat tracer for 60s..."
        run_hwlat_tracefs 60 "$TRACE_ROOT"
    else
        echo "  Running tracefs hwlat tracer for 10s (use --full for 60s)..."
        run_hwlat_tracefs 10 "$TRACE_ROOT"
    fi
else
    warn "hwlatdetect not available, and tracefs hwlat detector not found"
fi

echo ""
echo "-- CPU Isolation --"
ISOL=$(cat /sys/devices/system/cpu/isolated 2>/dev/null || echo "none")
NOHZ=$(cat /proc/cmdline | grep -oE 'nohz_full=[^ ]+' || echo "not set")
if [ "$ISOL" != "none" ] && [ "$ISOL" != "" ]; then
    ok "Isolated cores: $ISOL"
else
    warn "No isolated cores detected"
fi
echo "  nohz_full: $NOHZ"

echo ""
echo "-- Tuned --"
if [ -n "$TUNED_ADM_BIN" ]; then
    echo "  $("$TUNED_ADM_BIN" active 2>/dev/null || echo 'Current active profile: unavailable')"
else
    warn "tuned-adm not available"
fi

echo ""
echo "==============================================================="
echo " Low-latency checklist prompts"
echo "  (only BIOS version, kernel posture, SMI count, and hwlat presence are"
echo "   checked directly by this script)"
echo "  [ ] BIOS A34 validated"
echo "  [ ] USB Legacy Support disabled in BIOS"
echo "  [ ] Intel AMT disabled in BIOS"
echo "  [ ] Computrace disabled in BIOS"
echo "  [ ] C-States limited to C1 in BIOS"
echo "  [ ] tuned profile 't7810-low-latency' active"
echo "  [ ] hwlatdetect shows < 10us max latency"
echo "==============================================================="
